page { background: #f7f5f2; color: #2f2824; }
.profile { padding: 28rpx 24rpx 60rpx; }
.user_card { display:flex; align-items:center; padding:34rpx 28rpx; border-radius:26rpx; background:linear-gradient(135deg,#49362d,#755547); color:#fff; }
.user_icon { width:112rpx; height:112rpx; flex-shrink:0; border:5rpx solid rgba(255,255,255,.55); border-radius:50%; background:#eee; }
.user_copy { flex:1; margin-left:24rpx; }
.user_name { font-size:34rpx; font-weight:700; }
.user_desc { margin-top:10rpx; color:rgba(255,255,255,.68); font-size:22rpx; }
.logout { padding:12rpx 20rpx; border:1rpx solid rgba(255,255,255,.45); border-radius:30rpx; font-size:22rpx; }
.product_header { display:flex; align-items:center; justify-content:space-between; margin:38rpx 4rpx 22rpx; }
.product_title { font-size:34rpx; font-weight:700; }
.product_count { margin-top:7rpx; color:#99908a; font-size:22rpx; }
.publish_link { padding:15rpx 24rpx; border-radius:32rpx; background:#d5a676; color:#3c2a21; font-size:23rpx; font-weight:700; }
.product_item { margin-bottom:18rpx; overflow:hidden; border-radius:18rpx; background:#fff; }
.delete_tip { padding:16rpx; color:#aaa19b; font-size:21rpx; text-align:center; }
.empty_state { margin-top:24rpx; padding:80rpx 20rpx; border-radius:24rpx; background:#fff; text-align:center; }
.empty_icon { font-size:100rpx; opacity:.7; }
.empty_title { margin-top:20rpx; font-size:30rpx; font-weight:700; }
.empty_desc { margin-top:12rpx; color:#9b928c; font-size:23rpx; }
.empty_btn { width:220rpx; margin:34rpx auto 0; padding:18rpx 0; border-radius:40rpx; background:#49362d; color:#fff; font-size:24rpx; }
