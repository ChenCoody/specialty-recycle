<view class="profile">
  <view class="user_card">
    <image class="user_icon" src="{{user.avatar || '/images/avatar.png'}}"></image>
    <view class="user_copy">
      <view class="user_name">{{user.name || '未登录'}}</view>
      <view class="user_desc">闲置好物，让旧物焕发新生</view>
    </view>
    <view class="logout" bindtap="logout">退出</view>
  </view>

  <view class="product_header">
    <view>
      <view class="product_title">我的发布商品</view>
      <view class="product_count">共 {{goodsList.length}} 件商品</view>
    </view>
    <navigator class="publish_link" url="/pages/creation/creation" open-type="switchTab">+ 发表商品</navigator>
  </view>

  <view wx:if="{{goodsList.length}}" class="product_list">
    <block wx:for="{{goodsList}}" wx:key="id">
      <view class="product_item" bindlongpress="deleteGoods" data-index="{{index}}">
        <goodsItem item="{{item}}"></goodsItem>
      </view>
    </block>
    <view class="delete_tip">长按商品可以删除</view>
  </view>
  <view wx:else class="empty_state">
    <view class="empty_icon">👜</view>
    <view class="empty_title">还没有发布商品</view>
    <view class="empty_desc">把闲置的包和鞋分享出来吧</view>
    <navigator class="empty_btn" url="/pages/creation/creation" open-type="switchTab">去发表商品</navigator>
  </view>
</view>
