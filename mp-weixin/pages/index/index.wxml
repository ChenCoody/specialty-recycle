<view class="recycle_hero">
    <view class="hero_content">
        <view class="hero_tag">闲置焕新 · 循环利用</view>
        <view class="hero_title">回收旧包旧鞋旧手机</view>
        <view class="hero_desc">7、8成新均可回收，专业估价让闲置重新流转</view>
        <navigator class="recycle_btn" url="/pages/creation/creation">立即发布回收</navigator>
    </view>
    <view class="hero_mark">
        <text class="hero_bag">👜</text>
        <text class="hero_shoe">👟</text>
        <text class="hero_phone">📱</text>
    </view>
</view>

<view class="service_bar">
    <view><text>✓</text> 专业鉴定</view>
    <view><text>✓</text> 快速估价</view>
    <view><text>✓</text> 安心交易</view>
</view>

<view class="section">
    <view class="section_head">
        <view class="section_title">精品专区</view>
        <view class="section_subtitle">严选品质好物</view>
    </view>
    <view class="feature_grid">
        <view class="feature_card bag_card" bindtap="selectCategory" data-keyword="包">
            <view class="feature_copy">
                <view class="feature_title">精品包</view>
                <view class="feature_desc">经典设计 · 品质严选</view>
                <view class="feature_link">立即选购 ›</view>
            </view>
            <text class="feature_emoji">👜</text>
        </view>
        <view class="feature_card shoe_card" bindtap="selectCategory" data-keyword="鞋">
            <view class="feature_copy">
                <view class="feature_title">精品鞋</view>
                <view class="feature_desc">舒适潮流 · 成色优选</view>
                <view class="feature_link">立即选购 ›</view>
            </view>
            <text class="feature_emoji">👟</text>
        </view>
        <view class="feature_card phone_card" bindtap="selectCategory" data-keyword="手机">
            <view class="feature_copy">
                <view class="feature_title">旧手机</view>
                <view class="feature_desc">7、8成新 · 专业估价</view>
                <view class="feature_link">立即回收 ›</view>
            </view>
            <text class="feature_emoji">📱</text>
        </view>
    </view>
</view>

<view class="goods_head">
    <view class="goods_title">精选推荐</view>
    <view class="goods_line"></view>
</view>
<nodeList list="{{nodeList}}"></nodeList>
