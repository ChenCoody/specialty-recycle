.feedback_image_swap {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}
.feedback_image_swap .feedback_upload_btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  width: 150rpx;
  height: 150rpx;
  margin: 30rpx 30rpx 50rpx 2rpx;
  color: #cd8062;
}
.feedback_image_swap .feedback_image {
  width: 150rpx;
  height: 150rpx;
  margin: 30rpx 30rpx 50rpx 0;
  position: relative;
}
.feedback_image_swap .feedback_image image {
  width: 100%;
  height: 100%;
}
.feedback_image_swap .feedback_image video {
  width: 100%;
  height: 100%;
}
.feedback_image_swap .feedback_image icon {
  position: absolute;
  right: -22rpx;
  top: -22rpx;
}
.feedback_image_swap .feedback_image_node:nth-child(4n) {
  margin-right: 0;
}
.creation_form .creation_form_input {
  margin: 0 30rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
}
.creation_form .creation_form_editor {
  margin: 0 30rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
}
.creation_form .submit_btn {
  margin-top: 50rpx;
  background-color: #cd8062;
  color: #fff;
}
.delete_btn {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}
.delete_btn button {
  margin: 0;
}
.goods_container {
  position: fixed;
  z-index: 9999;
  background-color: #fff;
}
.goods_container .goods_container_scroll {
  height: 80vh;
}
.publish_page { min-height:100vh; padding:28rpx 24rpx 60rpx; box-sizing:border-box; background:#f7f5f2; }
.publish_header { padding:30rpx 24rpx; border-radius:22rpx; background:linear-gradient(135deg,#49362d,#755547); color:#fff; }
.publish_title { font-size:38rpx; font-weight:700; }
.publish_desc { margin-top:9rpx; color:rgba(255,255,255,.68); font-size:23rpx; }
.feedback_upload_btn { flex-direction:column; background:#fff !important; border:2rpx dashed #cfb5a4 !important; color:#8d5b42 !important; }
.feedback_upload_btn::after { border:none; }
.upload_plus { font-size:48rpx; line-height:52rpx; }
.upload_text { font-size:20rpx; }
.creation_form .creation_form_input { width:auto; margin:0; padding:0 22rpx; box-sizing:border-box; background:#fff; }
.creation_form .creation_form_editor { margin:18rpx 0; padding:10rpx 22rpx; box-sizing:border-box; background:#fff; }
.creation_form .submit_btn { border-radius:44rpx; background-color:#49362d; }
.price_row { display:flex; align-items:center; height:84rpx; margin-bottom:18rpx; padding:0 22rpx; background:#fff; color:#b46e43; font-size:34rpx; font-weight:700; }
.price_row input { flex:1; margin-left:14rpx; color:#2f2824; font-size:28rpx; font-weight:normal; }
