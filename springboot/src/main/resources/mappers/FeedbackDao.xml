<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lrb.dao.FeedbackDao">
  <select id="queryList" resultType="com.example.lrb.pojo.Feedback">SELECT f.*,u.name FROM feedback f JOIN `user` u ON u.id=f.user_id ORDER BY f.create_time DESC</select>
</mapper>
